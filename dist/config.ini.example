; ============================================================================
; Bookshelf Kobo Sync - example configuration
;
; Copy this file to `config.ini` next to the `bookshelf-kobo` binary, then
; replace the placeholder on the `authorization =` line with the sync token
; generated in the Bookshelf app under Settings → Kobo sync.
;
; Lines starting with `;` are comments and ignored. Don't wrap values in
; quotes - write `authorization = bks_...`, not `authorization = "bks_..."`.
; ============================================================================

; Your Bookshelf sync token (Settings → Kobo sync → "Generate token" in the
; Bookshelf mobile app). Keep this secret - anyone with it can write to
; your library. Replace the placeholder below with your actual token.
authorization = REPLACE_WITH_YOUR_TOKEN

; --- Sharing one Kobo between two readers -----------------------------------
; Leave both of these alone unless two people share this device.
;
; Paste the second reader's token here and each book is synced to whichever
; account claimed it. The choice is made per book in the Bookshelf app
; (Settings -> Kobo sync), not in this file. A book neither reader has
; claimed goes to `default_account`; a book *both* claimed is synced to
; both, which is what you want when you are genuinely reading the same copy.
;
; Each account needs its own Premium subscription - generating a token
; requires one.
authorization_2 =

; Which account gets a book nobody has claimed: 1 for `authorization`,
; 2 for `authorization_2`.
default_account = 1

; Base URL of the Bookshelf Cloud Functions. Only change if you're running
; against your own Firebase project.
server_url = https://us-central1-bookshelf-a829b.cloudfunctions.net

; Where to read the Kobo database. The default is correct for every
; supported Kobo device.
sqlite_path = /mnt/onboard/.kobo/KoboReader.sqlite

; What to do when Bookshelf already has more reading progress than the
; Kobo does for a given book.
;   kobo       Push Kobo's page anyway (treat the ereader as authoritative
;              even when it's behind - useful for re-reads)
;   bookshelf  Skip the page entry (keep Bookshelf as the source of truth)
;   auto       Take the max - only push if Kobo is ahead. Default.
conflict_resolution = auto

; When to upload Kobo highlights / annotations.
;   always    Every sync
;   never     Never
;   finished  Only when the book reaches 100 %
sync_bookmarks = always

; Verbose stderr logging.
debug = false
